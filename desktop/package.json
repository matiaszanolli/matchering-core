{
  "name": "auralis-desktop",
  "version": "1.5.1",
  "description": "Auralis Audio Mastering Desktop Application",
  "main": "main.js",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "Auralis Team",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "homepage": "https://github.com/matiaszanolli/Auralis",
  "repository": {
    "type": "git",
    "url": "https://github.com/matiaszanolli/Auralis.git"
  },
  "scripts": {
    "test": "node --test",
    "electron": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:mac": "pnpm run build:mac:arm64",
    "build:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "build:linux": "electron-builder --linux --x64 --publish never",
    "build:linux:flatpak": "electron-builder --linux flatpak --x64 --publish never",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "pnpm": {
    "overrides": {
      "app-builder-lib": "26.15.7",
      "electron-builder-squirrel-windows": "26.15.7",
      "fast-uri": "^3.1.5",
      "js-yaml": "^4.3.1"
    }
  },
  "build": {
    "appId": "com.auralis.desktop",
    "productName": "Auralis",
    "copyright": "Copyright © 2024 Auralis Team",
    "directories": {
      "output": "../dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "error.html"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!build/**",
          "!dist/**",
          "!__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": "resources/frontend",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/auralis",
        "to": "auralis",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.music",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/main.png",
      "category": "AudioVideo",
      "maintainer": "Auralis Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auralis"
    },
    "dmg": {
      "title": "Auralis ${version}",
      "icon": "assets/icon.icns",
      "writeUpdateInfo": false
    },
    "flatpak": {
      "runtimeVersion": "25.08",
      "baseVersion": "25.08",
      "category": "AudioVideo"
    },
    "publish": {
      "provider": "github",
      "owner": "matiaszanolli",
      "repo": "Auralis"
    }
  }
}
